# Font
font-family = Cascadia Code
font-family = FiraCode Nerd Font Mono
font-size = 12.0

# Colors (override Dracula defaults)
background = #250E2E
foreground = #F8F8F2
cursor-color = #8BE9FD
cursor-text = #0E1419
selection-background = #44475A

# Window
window-decoration = false
window-padding-x = 8
window-padding-y = 8

keybind = ctrl+,=text:nvim ~/.config/ghostty/config\r
keybind = ctrl+shift+p=unbind
